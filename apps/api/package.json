{
  "name": "@catalogue/api",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogue API (NestJS). Sits between the web client and the product data source.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "dev:inbox": "node dev/dev-inbox.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest && node --test dev/dev-inbox.test.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "npm run build && dotenv -e ../../.env -- prisma db seed"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@catalogue/contracts": "0.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "mailparser": "^3.14.1",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsc-watch": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(spec|int-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@catalogue/contracts$": "<rootDir>/../../packages/contracts/src/index.ts"
    },
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ]
  }
}
