{
  "name": "@catalogue/web",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogue web client (React + Ant Design + MobX). Talks only to the catalogue API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@catalogue/contracts": "0.1.0",
    "antd": "^6.6.8",
    "axios": "^1.21.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "stylelint": "^16.26.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
