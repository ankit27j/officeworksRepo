# Copy to .env:  cp .env.example .env
# No real secrets are needed to run locally. Never commit .env.

# --- Infrastructure (docker compose) ---
POSTGRES_USER=catalogue
POSTGRES_PASSWORD=catalogue
POSTGRES_DB=catalogue
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# npm run dev: the built-in dev inbox page (it receives SMTP on SMTP_PORT below)
INBOX_UI_PORT=8025
WEB_PORT=8080                       # docker compose: the web app (and /api through nginx)

# --- API ---
NODE_ENV=development
API_PORT=3000
# memory   = no database needed: picks come from apps/api/src/modules/catalog/featured-picks.ts and
#            enquiries are kept in memory (lost on restart).
# postgres = durable storage (docker compose uses this). Needs DATABASE_URL.
STORAGE=memory
# Host values below are for npm run dev; docker compose uses in-network hostnames (db, mailpit).
DATABASE_URL=postgresql://catalogue:catalogue@localhost:5432/catalogue
PRODUCT_SOURCE=fakestore            # fakestore | fixture
FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOG_CACHE_TTL_SECONDS=300
MAILER=smtp                         # smtp | log (log = print instead of sending)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false                   # true for port 465 (implicit TLS)
# Leave empty for Mailpit. A real provider (e.g. AWS SES SMTP) needs credentials,
# which belong in the deployment's secret store, never in this file.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Catalogue <no-reply@catalogue.local>"
SALES_INBOX_EMAIL=sales@catalogue.local
CORS_ORIGIN=http://localhost:5173
ENQUIRY_RATE_LIMIT_PER_MIN=5
# Proxies in front of the API, so the rate limit sees real client IPs. docker compose sets 1 (nginx).
TRUST_PROXY_HOPS=0

# --- Web ---
VITE_API_BASE_URL=/api/v1
